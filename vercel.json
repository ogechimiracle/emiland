{
  "version": 2,
  "framework": "vite",
  "rewrites": [
    {
      "source": "/src/assets/images/(.*)",
      "destination": "/assets/images/$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
